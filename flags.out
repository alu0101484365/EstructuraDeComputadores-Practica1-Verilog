#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 11;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x652bf5e07ef0 .scope module, "flags_tb" "flags_tb" 2 3;
 .timescale -9 -11;
v0x652bf5e1c760_0 .var "test_c_out", 0 0;
v0x652bf5e1c820_0 .net "test_carry", 0 0, L_0x652bf5e1ce30;  1 drivers
v0x652bf5e1c8c0_0 .var "test_r", 3 0;
v0x652bf5e1c9c0_0 .net "test_sign", 0 0, L_0x652bf5e1cd40;  1 drivers
v0x652bf5e1ca90_0 .net "test_zero", 0 0, L_0x652bf5e1cbb0;  1 drivers
S_0x652bf5e08080 .scope module, "flag1" "flags" 2 11, 3 8 0, S_0x652bf5e07ef0;
 .timescale 0 0;
    .port_info 0 /OUTPUT 1 "carry";
    .port_info 1 /OUTPUT 1 "zero";
    .port_info 2 /OUTPUT 1 "sign";
    .port_info 3 /INPUT 4 "R";
    .port_info 4 /INPUT 1 "c_out";
L_0x7530ef29d060 .functor BUFT 1, C4<1>, C4<0>, C4<0>, C4<0>;
L_0x652bf5e1ce30 .functor XNOR 1, v0x652bf5e1c760_0, L_0x7530ef29d060, C4<0>, C4<0>;
v0x652bf5e08260_0 .net "R", 3 0, v0x652bf5e1c8c0_0;  1 drivers
L_0x7530ef29d018 .functor BUFT 1, C4<0000>, C4<0>, C4<0>, C4<0>;
v0x652bf5e1c1d0_0 .net/2u *"_ivl_0", 3 0, L_0x7530ef29d018;  1 drivers
v0x652bf5e1c2b0_0 .net/2u *"_ivl_6", 0 0, L_0x7530ef29d060;  1 drivers
v0x652bf5e1c370_0 .net "c_out", 0 0, v0x652bf5e1c760_0;  1 drivers
v0x652bf5e1c430_0 .net "carry", 0 0, L_0x652bf5e1ce30;  alias, 1 drivers
v0x652bf5e1c540_0 .net "sign", 0 0, L_0x652bf5e1cd40;  alias, 1 drivers
v0x652bf5e1c600_0 .net "zero", 0 0, L_0x652bf5e1cbb0;  alias, 1 drivers
L_0x652bf5e1cbb0 .cmp/eq 4, v0x652bf5e1c8c0_0, L_0x7530ef29d018;
L_0x652bf5e1cd40 .part v0x652bf5e1c8c0_0, 3, 1;
    .scope S_0x652bf5e07ef0;
T_0 ;
    %vpi_call 2 15 "$monitor", "tiempo=%0d c_out=%b R=%b -> carry=%b zero=%b sign=%b", $time, v0x652bf5e1c760_0, v0x652bf5e1c8c0_0, v0x652bf5e1c9c0_0, v0x652bf5e1ca90_0, v0x652bf5e1c820_0 {0 0 0};
    %vpi_call 2 16 "$dumpfile", "flags.vcd" {0 0 0};
    %vpi_call 2 17 "$dumpvars" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x652bf5e1c760_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x652bf5e1c8c0_0, 0, 4;
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x652bf5e1c760_0, 0, 1;
    %pushi/vec4 14, 0, 4;
    %store/vec4 v0x652bf5e1c8c0_0, 0, 4;
    %delay 2000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x652bf5e1c760_0, 0, 1;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x652bf5e1c8c0_0, 0, 4;
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x652bf5e1c760_0, 0, 1;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x652bf5e1c8c0_0, 0, 4;
    %delay 2000, 0;
    %vpi_call 2 36 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "flags_tb.v";
    "flags.v";
