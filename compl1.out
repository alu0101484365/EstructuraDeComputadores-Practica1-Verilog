    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5e9c5690d1a0_0, 0, 4;
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e9c5690d100_0, 0, 1;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5e9c5690d1a0_0, 0, 4;
