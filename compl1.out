v0x5e9c5690cfc0_0 .net "cpl", 0 0, v0x5e9c5690d100_0;  1 drivers
L_0x5e9c5690d5a0 .functor MUXZ 4, v0x5e9c5690d1a0_0, L_0x5e9c5690d4e0, L_0x5e9c5690d3a0, C4<>;
    .scope S_0x5e9c568f9810;
T_0 ;
    %vpi_call 2 15 "$monitor", "tiempo=%0d test_out=%b <- test_inp=%b test_cpl=%b", $time, v0x5e9c5690d270_0, v0x5e9c5690d1a0_0, v0x5e9c5690d100_0 {0 0 0};
    %vpi_call 2 16 "$dumpfile", "cpl.vcd" {0 0 0};
    %vpi_call 2 17 "$dumpvars" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e9c5690d100_0, 0, 1;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5e9c5690d1a0_0, 0, 4;
    %delay 2000, 0;
